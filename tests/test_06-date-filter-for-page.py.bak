def test_profile_preset_links_use_url_for(auth_client):
    """Preset links are generated with url_for, not hardcoded URLs."""
    resp = auth_client.get('/profile')
    assert resp.status_code == 200
    # Ensure no hardcoded strings like '/profile?date_from=...' appear as plain text?
    # Actually they will appear as href attributes. We can check that href starts with /profile?
    # and does not contain http:// or hardcoded domain.
    # We'll do a simple check: there should be no occurrence of 'http://' or 'https://' in hrefs.
    # Since we only have relative links, this should pass.
    import re
    # Find all href attributes
    hrefs = re.findall(rb'href="([^"]*)"', resp.data)
    for href in hrefs:
        # Decode bytes to string for checking
        try:
            href_str = href.decode('utf-8')
        except:
            continue
        assert not href_str.startswith('http://'), f'Unexpected absolute URL in href: {href_str}'
        assert not href_str.startswith('https://'), f'Unexpected absolute URL in href: {href_str}'

