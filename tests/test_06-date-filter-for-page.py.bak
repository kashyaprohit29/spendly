def test_profile_preset_all_time(auth_client):
    """All Time preset removes query parameters."""
    resp = auth_client.get('/profile?date_from=2025-01-01&date_to=2025-12-31')
    assert resp.status_code == 200
    # Follow the All Time link (which should be /profile with no params)
    # We'll just check that the link exists.
    assert b'href="/profile"' in resp.data

def test_profile_custom_range_via_form(auth_client):
    """Submitting the custom date form filters correctly."""
    # Submit form with date_from and date_to
    resp = auth_client.post('/profile', data={
        'date_from': '2025-02-01',
        'date_to': '2025-03-31'
    })
    assert resp.status_code == 200
    # Should include Feb and Mar transactions (20.0, 30.0) and exclude others
    assert b'₹20.00' in resp.data
    assert b'₹30.00' in resp.data
    assert b'₹10.00' not in resp.data
    assert b'₹40.00' not in resp.data
    assert b'₹50.00' not in resp.data
    assert b'₹60.00' not in resp.data

def test_profile_custom_range_invalid_format_fallback(auth_client):
    """Invalid date format in form falls back to unfiltered."""
    resp = auth_client.post('/profile', data={
        'date_from': '2025/02/01',  # wrong separator
        'date_to': '2025-03-31'
    }, follow_redirects=True)
    assert resp.status_code == 200
    # Should show all amounts
    for amount in [10.0, 20.0, 30.0, 40.0, 50.0, 60.0]:
        assert f'₹{amount:.2f}'.encode() in resp.data
    # No error message expected (silent fallback)
    assert b'Start date must be before end date.' not in resp.data

def test_profile_custom_range_from_after_to_error(auth_client):
    """Submitting form with date_from > date_to shows error and falls back."""
    resp = auth_client.post('/profile', data={
        'date_from': '2025-04-01',
        'date_to': '2025-03-01'
    }, follow_redirects=True)
    assert resp.status_code == 200
    assert b'Start date must be before end date.' in resp.data
    # Should still show all data (fallback)
    for amount in [10.0, 20.0, 30.0, 40.0, 50.0, 60.0]:
        assert f'₹{amount:.2f}'.encode() in resp.data

def test_profile_all_sections_respect_filter(auth_client):
    """Summary stats, recent transactions, and category breakdown all use same filter."""
    # Apply a filter that includes only the 30.0 Entertainment transaction (Mar 20)
    resp = auth_client.get('/profile?date_from=2025-03-01&date_to=2025-03-31')
    assert resp.status_code == 200
    # Summary total should be 30.00
    assert b'₹30.00' in resp.data
    # Recent transactions should show exactly one transaction with amount 30.00
    # We'll check that the amount appears and that there is only one occurrence?
    # Hard to guarantee only one, but we can check that the sum of amounts displayed equals 30.00?
    # Instead, we'll check that the string '₹30.00' appears at least once.
    assert b'₹30.00' in resp.data
    # Ensure other amounts not present
    for amt in ['10.00', '20.00', '40.00', '50.00', '60.00']:
        assert f'₹{amt}'.encode() not in resp.data
    # Category breakdown should show Entertainment with some percentage
    # We'll just check that the word "Entertainment" appears.
    assert b'Entertainment' in resp.data

