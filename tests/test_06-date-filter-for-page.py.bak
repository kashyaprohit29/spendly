import pytest
from app import app as flask_app
from database.db import get_db, init_db, create_user
import sqlite3
from datetime import datetime, timedelta

@pytest.fixture
def app():
    flask_app.config.update({
        'TESTING': True,
        'DATABASE': ':memory:',
        'SECRET_KEY': 'test-secret',
        'WTF_CSRF_ENABLED': False,
    })
    with flask_app.app_context():
        init_db()
        yield flask_app

@pytest.fixture
def client(app):
    return flask_app.test_client()

@pytest.fixture
def auth_client(client):
    """Create a user and log in."""
    # Create a test user
    user, err = create_user('Test User', 'test@example.com', 'testpass')
    assert err is None
    assert user is not None
    user_id = user['id']

    # Insert test expenses for this user across various dates
    conn = get_db()
    try:
        # Base date: 2025-01-15, then add months/weeks
        base = datetime(2025, 1, 15)
        expenses = [
            (user_id, 10.0, 'Food', (base).strftime('%Y-%m-%d'), 'Lunch'),
            (user_id, 20.0, 'Transport', (base + timedelta(days=30)).strftime('%Y-%m-%d'), 'Gas'),
            (user_id, 30.0, 'Entertainment', (base + timedelta(days=60)).strftime('%Y-%m-%d'), 'Concert'),
            (user_id, 40.0, 'Bills', (base + timedelta(days=120)).strftime('%Y-%m-%d'), 'Electricity'),
            (user_id, 50.0, 'Shopping', (base + timedelta(days=200)).strftime('%Y-%m-%d'), 'Jacket'),
            (user_id, 60.0, 'Other', (base + timedelta(days=350)).strftime('%Y-%m-%d'), 'Gift'),
        ]
        conn.executemany(
            'INSERT INTO expenses (user_id, amount, category, date, description) VALUES (?, ?, ?, ?, ?)',
            expenses
        )
        conn.commit()
    finally:
        conn.close()

    # Log in
    client.post('/login', data={'username': 'test@example.com', 'password': 'testpass'})
    return client

def test_profile_requires_login(client):
    """Unauthenticated access to /profile redirects to login."""
    resp = client.get('/profile', follow_redirects=False)
    assert resp.status_code == 302
    assert '/login' in resp.location

def test_profile_shows_all_expenses_by_default(auth_client):
    """Authenticated user sees all expenses when no date filter is applied."""
    resp = auth_client.get('/profile')
    assert resp.status_code == 200
    # Check that all test expenses appear in the response (by amount)
    for amount in [10.0, 20.0, 30.0, 40.0, 50.0, 60.0]:
        assert f'₹{amount:.2f}'.encode() in resp.data

def test_profile_date_filter_no_params_equals_unfiltered(auth_client):
    """Explicitly providing no date_from/date_to yields same as no params."""
    resp1 = auth_client.get('/profile')
    resp2 = auth_client.get('/profile?date_from=&date_to=')
    assert resp1.status_code == 200
    assert resp2.status_code == 200
    # Responses should be identical (or at least contain same amounts)
    for amount in [10.0, 20.0, 30.0, 40.0, 50.0, 60.0]:
        assert f'₹{amount:.2f}'.encode() in resp2.data

def test_profile_date_filter_valid_range(auth_client):
    """Filtering with a valid date range returns only expenses within that range."""
    # Select range covering Feb, Mar, Apr (2025-02-14 to 2025-04-30)
    resp = auth_client.get('/profile?date_from=2025-02-14&date_to=2025-04-30')
    assert resp.status_code == 200
    # Should include: 20.0 (Transport), 30.0 (Entertainment)
    # Should NOT include: 10.0 (Jan), 40.0 (May? actually May? Wait our dates:
    # 10 Jan, 20 Feb, 30 Mar, 40 May? Let's recalc: base Jan 15 +30 = Feb14? Actually Jan15 +30days = Feb14 (yes)
    # +60 days = Apr15? Wait Jan15 +60 = Mar16? Let's compute precisely later but trust.
    # We'll just check for presence of expected amounts.
    assert b'₹20.00' in resp.data
    assert b'₹30.00' in resp.data
    # Ensure amounts outside range are not present
    assert b'₹10.00' not in resp.data  # Jan
    assert b'₹40.00' not in resp.data  # May? Actually our 40 is May? Let's compute: Jan15 +120 days = May14? Not in range.
    assert b'₹50.00' not in resp.data  # Aug
    assert b'₹60.00' not in resp.data  # Jan next year

def test_profile_date_filter_out_of_range_returns_none(auth_client):
    """Filter with range that matches no expenses shows zero state."""
    resp = auth_client.get('/profile?date_from=2024-01-01&date_to=2024-12-31')
    assert resp.status_code == 200
    # Should show zero total and no transactions
    assert b'₹0.00' in resp.data  # total spent
    # Check for empty transaction list - assume there is a message like "No transactions"
    # We'll just ensure no amount rows appear
    for amount in ['10.00', '20.00', '30.00', '40.00', '50.00', '60.00']:
        assert f'₹{amount}'.encode() not in resp.data

def test_profile_date_filter_from_greater_than_to_shows_error_and_falls_back(auth_client):
    """When date_from > date_to, flash error and show unfiltered data."""
    resp = auth_client.get('/profile?date_from=2025-12-31&date_to=2025-01-01', follow_redirects=True)
    assert resp.status_code == 200
    # Check for flash error message
    assert b'Start date must be before end date.' in resp.data
    # Should still show all expenses (fallback)
    for amount in [10.0, 20.0, 30.0, 40.0, 50.0, 60.0]:
        assert f'₹{amount:.2f}'.encode() in resp.data

def test_profile_date_filter_invalid_format_ignored(auth_client):
    """Malformed date strings are ignored (fallback to unfiltered)."""
    resp = auth_client.get('/profile?date_from=not-a-date&date_to=also-bad', follow_redirects=True)
    assert resp.status_code == 200
    # No flash error expected (silent fallback)
    assert b'Start date must be before end date.' not in resp.data
    # Should show all expenses
    for amount in [10.0, 20.0, 30.0, 40.0, 50.0, 60.0]:
        assert f'₹{amount:.2f}'.encode() in resp.data

